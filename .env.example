# =============================================================
# TENPO ONE 環境変数
# 秘密値は絶対にこのファイルへ書かないこと（本ファイルはGit管理対象）
# =============================================================

# --- Vercel / アプリ本体に必須 -------------------------------

# Supabaseプロジェクト（Project Settings → API）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# サーバー専用（スタッフ招待・PIN打刻照合・運営コンソール）。
# クライアントへ渡さない。NEXT_PUBLIC_ を付けない。
SUPABASE_SERVICE_ROLE_KEY=

# 本番URL（例: https://tenpo-one.example.com）
# 未設定の場合 canonical/OG/sitemap を出力せず robots は noindex（プレビュー誤インデックス防止）
NEXT_PUBLIC_SITE_URL=

# --- ローカルスクリプト専用（Vercelには不要） -----------------

# seed / verify スクリプト用のSupabase URL（NEXT_PUBLIC_SUPABASE_URLと同値でよい。
# 未設定時はNEXT_PUBLIC_SUPABASE_URLへフォールバックする）
SUPABASE_URL=

# デモデータ・E2Eのログインパスワード（省略時: TenpoOne-Demo1!）
# DEMO_PASSWORD=

# E2E（Playwright）をデプロイ環境に対して実行する場合のみ
# BASE_URL=https://tenpo-one.example.com

# --- Stripe（決済・Test Modeで使用。フェーズ2で実装） ---------

# Stripe Dashboard → Developers → API keys（テストモードのキーを使用）
# Secret Key はサーバー専用。NEXT_PUBLIC_ を絶対に付けない。
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# Stripe Webhook 署名シークレット（Developers → Webhooks → Signing secret）
STRIPE_WEBHOOK_SECRET=
