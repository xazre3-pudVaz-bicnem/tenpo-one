# === TENPO ONE 環境変数 ===
# Supabaseプロジェクト（https://supabase.com/dashboard → Project Settings → API）

# 公開可（ブラウザに露出する）
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# サーバー専用（絶対にクライアントへ渡さない）
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# seedスクリプト用（NEXT_PUBLIC_SUPABASE_URLと同じ値でよい）
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co

# デモデータのログインパスワード（未設定時: TenpoOne-Demo1!）
# DEMO_PASSWORD=

# 本番URL（未設定の場合、canonical/OG/sitemapを出力せず robots は Disallow）
# NEXT_PUBLIC_SITE_URL=https://tenpo-one.example.com
