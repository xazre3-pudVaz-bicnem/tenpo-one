<?xml version="1.0" encoding="utf-8"?>
<!-- stera terminal standard は 4 インチ 720×1184。縦1列・大きい文字で -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/title"
            android:textColor="@color/charcoal"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/subtitle"
            android:textColor="@color/ink3"
            android:textSize="12sp" />

        <!-- 状態 -->
        <LinearLayout
            android:id="@+id/statusCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:id="@+id/statusText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/status_idle"
                android:textColor="@color/charcoal"
                android:textSize="17sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/detailText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textColor="@color/ink2"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- レジからの会計（決済中だけ出す） -->
        <LinearLayout
            android:id="@+id/requestCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_request"
            android:orientation="vertical"
            android:padding="14dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/request_title"
                android:textColor="#CCFAF6EF"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/requestAmount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cream"
                android:textSize="34sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/requestType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="@color/cream"
                android:textSize="15sp" />
        </LinearLayout>

        <!-- 設定 -->
        <LinearLayout
            android:id="@+id/settingsCard"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:padding="12dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/link_code_label"
                android:textColor="@color/ink2"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/linkCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/link_code_hint"
                android:imeOptions="actionDone"
                android:inputType="textCapCharacters|textNoSuggestions"
                android:maxLength="14"
                android:textAllCaps="true"
                android:textSize="20sp"
                android:typeface="monospace" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="@string/server_label"
                android:textColor="@color/ink2"
                android:textSize="12sp" />

            <EditText
                android:id="@+id/serverUrl"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="@string/server_hint"
                android:imeOptions="actionDone"
                android:inputType="textUri"
                android:textSize="14sp" />

            <CheckBox
                android:id="@+id/practiceMode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="@string/practice_mode"
                android:textColor="@color/ink2"
                android:textSize="12sp" />

            <Button
                android:id="@+id/connectButton"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:layout_marginTop="8dp"
                android:backgroundTint="@color/terracotta"
                android:text="@string/connect"
                android:textColor="@color/cream"
                android:textSize="17sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- 記録（直近） -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:text="@string/log_title"
            android:textColor="@color/ink3"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/logText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:textColor="@color/ink2"
            android:textSize="11sp"
            android:typeface="monospace" />

        <TextView
            android:id="@+id/versionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:textColor="@color/ink3"
            android:textSize="11sp" />
    </LinearLayout>
</ScrollView>
